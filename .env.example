# ===================================================================
# SERVER CONFIGURATION
# ===================================================================
PORT=8080

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
# In docker-compose, POSTGRES_URL host is the "postgres" service name.
POSTGRES_URL=jdbc:postgresql://postgres:5432/AmbikaEstate
POSTGRES_DB=AmbikaEstate
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me

# ===================================================================
# SECURITY CONFIGURATION
# ===================================================================
# JWT Secret Key (minimum 32 bytes for HS256)
JWT_SECRET=your-super-secret-jwt-key-that-is-long-enough-for-hs256

# CORS Configuration - comma-separated list of allowed origins
# Development: local development URLs
# Production: your domain names and Vercel deployment URL
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:3001,https://ambikarealestate.com,https://www.ambikarealestate.com,https://your-app-name.vercel.app

# ===================================================================
# API CONFIGURATION
# ===================================================================
# Base URL for API endpoints (used in image URLs and external references)
# Development: http://localhost:8080
# Production: Your production backend URL
API_URL=http://localhost:8080

# ===================================================================
# FILE UPLOAD CONFIGURATION
# ===================================================================
UPLOAD_DIR=./uploads/property-images

# ===================================================================
# EMAIL CONFIGURATION
# ===================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===================================================================
# WHATSAPP (TWILIO) CONFIGURATION
# ===================================================================
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=whatsapp:+1234567890

# ===================================================================
# THIRD-PARTY API KEYS
# ===================================================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
YOUTUBE_API_KEY=your-youtube-api-key

# ===================================================================
# OCI OBJECT STORAGE (nightly backups - see backup.sh)
# ===================================================================
OCI_BUCKET=ambika-db-backups
OCI_NAMESPACE=your-oci-namespace
OCI_REGION=ap-mumbai-1
# Uses the OCI CLI's configured profile (~/.oci/config); no key material here.
